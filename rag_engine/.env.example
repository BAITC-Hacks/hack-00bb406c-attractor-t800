# Скопируйте в .env и задайте уникальные секреты перед запуском за пределами ноутбука.
RAG_DB_PASSWORD=replace-with-long-random-password
RAG_API_KEY=replace-with-long-random-api-key
RAG_PORT=8000
DATASET_DIR=/absolute/path/to/career_quest_dataset
EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
